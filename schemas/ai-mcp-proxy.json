                                "field_sources": [
                                  "ssl",
                                  "ssl_verify"
                                ],
                                "run_with_missing_fields": true
                              }
                            }
                          ],
                          "required": true
                        }
                      }
                    ]
                  }
                }
              ],
              "required": false,
              "type": "record"
            }
          },
          {
            "logging": {
              "type": "record",
